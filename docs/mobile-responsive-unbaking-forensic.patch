--- /dev/null
+++ b/tests/test_scaffold_forensic_media_aware.py
@@ -0,0 +1,267 @@
+"""@media-aware forensic box-model strip (UI_CLONE_FORENSIC_MEDIA_AWARE).
+
+The forensic className-only mode drops inline box-model props for ref-CSS-covered
+nodes so the ref CSS (incl @media) drives every viewport. The naive strip is
+@media-agnostic and collapses desktop (loop-nv-1 spike: docHeight -37%). The
+media-aware refinement (`UI_CLONE_FORENSIC_MEDIA_AWARE=1`, default off, gated
+under UI_CLONE_FORENSIC_CLASSNAME_ONLY) strips an inline prop ONLY when a real
+@media rule overrides it for the node's class — desktop base stays inline, only
+the mobile-overridden delta yields.
+
+These tests pin the two correctness edges codex flagged:
+ 1. selector SUBJECT only — a descendant rule `.page .card{}` must not mark the
+    ancestor `.page`, or root/scope wrappers lose their desktop inline layout;
+ 2. SCREEN media only — a print-only `@media print{}` rule must be ignored, since
+    it never applies during on-screen visual verification.
+Plus a positive control: a screen `@media (max-width)` rule DOES strip.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "skills" / "visual-debug" / "scripts" / "scaffold-to-jsx.sh"
+
+_FORENSIC_ENV = {
+    "UI_CLONE_FORENSIC_CLASSNAME_ONLY": "1",
+    "UI_CLONE_FORENSIC_MEDIA_AWARE": "1",
+}
+
+
+def _run(tmp_path: Path, structure: dict, sections: list[str], css: str) -> Path:
+    ref, impl = tmp_path / "ref", tmp_path / "impl"
+    (impl / "src").mkdir(parents=True)
+    (ref / "css").mkdir(parents=True)
+    (ref / "structure.json").write_text(json.dumps(structure), encoding="utf-8")
+    (ref / "section-map.json").write_text(json.dumps({"sections": [
+        {"index": i, "tag": "section", "cls": s} for i, s in enumerate(sections)]}),
+        encoding="utf-8")
+    (ref / "generation-plan.json").write_text(json.dumps(
+        {"forensicPreservation": {"required": True,
+                                   "strategy": "ref-derived-jsx-with-local-css"}}),
+        encoding="utf-8")
+    (ref / "css" / "main.css").write_text(css, encoding="utf-8")
+    (impl / "package.json").write_text('{"name":"i","dependencies":{}}', encoding="utf-8")
+    proc = subprocess.run(["bash", str(SCRIPT), str(ref), str(impl)],
+                          capture_output=True, text=True, timeout=30,
+                          env={**os.environ, **_FORENSIC_ENV})
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    return impl / "src"
+
+
+def _style_of(src_dir: Path, cls: str) -> str:
+    for tsx in src_dir.rglob("*.tsx"):
+        body = tsx.read_text(encoding="utf-8")
+        m = re.search(r'className="' + re.escape(cls) + r'"[^>]*?style=\{\{([^}]*)\}\}', body)
+        if m:
+            return m.group(1)
+        if f'className="{cls}"' in body:
+            return ""  # element present but no inline style block
+    raise AssertionError(f"no element with className={cls!r}")
+
+
+def _tree(child_styles: dict, parent_styles: dict) -> dict:
+    # body carries its OWN non-scope class so Fix 130 does not adopt `.parent`
+    # onto the App root div (which would give the root className="parent" and
+    # confuse an element-by-class match). `app-shell` scopes nothing in the css.
+    return {"tag": "body", "class": "app-shell", "styles": {"width": "1440px"},
+            "children": [
+        {"tag": "section", "class": "parent", "styles": parent_styles, "children": [
+            {"tag": "div", "class": "child", "text": "Title", "styles": child_styles},
+        ]},
+    ]}
+
+
+def test_descendant_rule_does_not_strip_ancestor_inline(tmp_path: Path) -> None:
+    # `.parent .child{padding-left:0}` targets .child; .parent must KEEP its
+    # baked padding-left (the desktop truth) — codex P2 subject-only.
+    src = _run(
+        tmp_path,
+        _tree(child_styles={"padding-left": "16px"},
+              parent_styles={"padding-left": "64px", "padding-right": "32px"}),
+        ["parent"],
+        ".child{padding-left:16px}"
+        "@media screen and (max-width:768px){.parent .child{padding-left:0}}",
+    )
+    assert "paddingLeft" in _style_of(src, "parent"), (
+        "ancestor .parent lost its desktop paddingLeft to a descendant-scoped "
+        "media rule that never matches it"
+    )
+    # the actual subject .child SHOULD yield its padding-left to the media rule
+    assert "paddingLeft" not in _style_of(src, "child"), (
+        ".child is the media rule subject; its inline paddingLeft must be stripped"
+    )
+
+
+def test_print_media_query_is_ignored(tmp_path: Path) -> None:
+    # print-only override must not strip the on-screen inline layout — codex P2.
+    src = _run(
+        tmp_path,
+        _tree(child_styles={"padding-left": "16px"}, parent_styles={}),
+        ["parent"],
+        ".child{padding-left:16px}@media print{.child{padding-left:0}}",
+    )
+    assert "paddingLeft" in _style_of(src, "child"), (
+        "a print-only @media override stripped the screen inline paddingLeft"
+    )
+
+
+def test_screen_viewport_rule_strips_subject(tmp_path: Path) -> None:
+    # positive control: a bare screen viewport rule targeting the element itself
+    # DOES strip, so the ref @media can drive mobile.
+    src = _run(
+        tmp_path,
+        _tree(child_styles={"padding-left": "16px"}, parent_styles={}),
+        ["parent"],
+        ".child{padding-left:16px}@media (max-width:768px){.child{padding-left:0}}",
+    )
+    assert "paddingLeft" not in _style_of(src, "child"), (
+        "screen viewport media rule must strip the subject's inline paddingLeft "
+        "so the ref @media drives it at mobile"
+    )
+
+
+def test_media_override_without_base_rule_keeps_inline(tmp_path: Path) -> None:
+    # loop-nv-1 remeasure guard: a prop overridden by @media but with NO desktop
+    # base rule (its desktop value lives ONLY in the inline capture, like
+    # navercorp news-masonry/tech-grid width) must be KEPT — stripping it would
+    # remove the desktop truth and reflow the element (desktop regression).
+    src = _run(
+        tmp_path,
+        _shell([{"tag": "div", "class": "child", "text": "A",
+                 "styles": {"width": "300px"}}]),
+        ["parent"],
+        "@media (max-width:768px){.child{width:100%}}",  # no base .child{width:...}
+    )
+    assert "width" in _style_of(src, "child"), (
+        "inline-only desktop width was stripped despite no ref base rule → "
+        "desktop reflow (the loop-nv-1 mid/tech regression)"
+    )
+
+
+def _shell(children: list[dict]) -> dict:
+    return {"tag": "body", "class": "app-shell", "styles": {"width": "1440px"},
+            "children": [{"tag": "section", "class": "parent", "styles": {},
+                          "children": children}]}
+
+
+def test_compound_subject_requires_all_classes(tmp_path: Path) -> None:
+    # `.card.featured{padding-left:0}` matches ONLY an element with BOTH classes;
+    # a node with just `card` must keep its inline paddingLeft — codex P2 compound.
+    src = _run(
+        tmp_path,
+        _shell([
+            {"tag": "div", "class": "card", "text": "A",
+             "styles": {"padding-left": "24px"}},
+            {"tag": "div", "class": "card featured", "text": "B",
+             "styles": {"padding-left": "24px"}},
+        ]),
+        ["parent"],
+        ".card.featured{padding-left:24px}"
+        "@media (max-width:768px){.card.featured{padding-left:0}}",
+    )
+    assert "paddingLeft" in _style_of(src, "card"), (
+        "node with only .card was stripped by a rule requiring .card.featured"
+    )
+    assert "paddingLeft" not in _style_of(src, "card featured"), (
+        "node matching the full .card.featured compound must be stripped"
+    )
+
+
+def test_logical_start_side_strips_one_physical_side(tmp_path: Path) -> None:
+    # `padding-inline-start` overrides ONE side (left in LTR); the opposite
+    # physical side's desktop inline must survive — codex P2 logical props.
+    src = _run(
+        tmp_path,
+        _shell([
+            {"tag": "div", "class": "child", "text": "A",
+             "styles": {"padding-left": "16px", "padding-right": "48px"}},
+        ]),
+        ["parent"],
+        ".child{padding-left:16px}"
+        "@media (max-width:768px){.child{padding-inline-start:0}}",
+    )
+    style = _style_of(src, "child")
+    assert "paddingLeft" not in style, (
+        "inline-start override must strip the left (start) physical side"
+    )
+    assert "paddingRight" in style, (
+        "inline-start override must NOT strip the right (end) side it never sets"
+    )
+
+
+def test_negated_and_mixed_print_queries_still_index(tmp_path: Path) -> None:
+    # `@media not print{...}` and `@media print,(max-width){...}` DO apply on
+    # screen; their subject overrides must still strip — codex P2 screen filter.
+    for idx, css in enumerate((
+        ".child{padding-left:16px}@media not print{.child{padding-left:0}}",
+        ".child{padding-left:16px}@media print,(max-width:768px){.child{padding-left:0}}",
+    )):
+        src = _run(
+            tmp_path / f"case{idx}",
+            _shell([{"tag": "div", "class": "child", "text": "A",
+                     "styles": {"padding-left": "16px"}}]),
+            ["parent"], css,
+        )
+        assert "paddingLeft" not in _style_of(src, "child"), (
+            f"screen-applicable media query was skipped: {css!r}"
+        )
+
+
+def test_not_pseudo_class_arg_is_not_a_required_class(tmp_path: Path) -> None:
+    # `.card:not(.featured)` matches a plain `.card`; the `.featured` inside
+    # :not() is negative, NOT a required class — a plain `.card` must strip so the
+    # mobile rule can override it (codex P2 pseudo-class args).
+    src = _run(
+        tmp_path,
+        _shell([{"tag": "div", "class": "card", "text": "A",
+                 "styles": {"padding-left": "16px"}}]),
+        ["parent"],
+        ".card{padding-left:16px}"
+        "@media (max-width:768px){.card:not(.featured){padding-left:0}}",
+    )
+    assert "paddingLeft" not in _style_of(src, "card"), (
+        ".card:not(.featured) must strip a plain .card; :not() arg is not required"
+    )
+
+
+def test_only_print_and_not_screen_are_skipped(tmp_path: Path) -> None:
+    # `@media only print` and `@media not screen` never apply on screen — their
+    # overrides must NOT strip the screen inline (codex P2 media modifiers).
+    for idx, css in enumerate((
+        ".child{padding-left:16px}@media only print{.child{padding-left:0}}",
+        ".child{padding-left:16px}@media not screen{.child{padding-left:0}}",
+    )):
+        src = _run(
+            tmp_path / f"m{idx}",
+            _shell([{"tag": "div", "class": "child", "text": "A",
+                     "styles": {"padding-left": "16px"}}]),
+            ["parent"], css,
+        )
+        assert "paddingLeft" in _style_of(src, "child"), (
+            f"a non-screen media query stripped the screen inline: {css!r}"
+        )
+
+
+def test_media_aware_flag_off_is_noop(tmp_path: Path) -> None:
+    # Without the flag, nothing is stripped (default runs untouched).
+    ref, impl = tmp_path / "ref", tmp_path / "impl"
+    (impl / "src").mkdir(parents=True)
+    (ref / "css").mkdir(parents=True)
+    (ref / "structure.json").write_text(json.dumps(
+        _tree(child_styles={"padding-left": "16px"}, parent_styles={})), encoding="utf-8")
+    (ref / "section-map.json").write_text(json.dumps(
+        {"sections": [{"index": 0, "tag": "section", "cls": "parent"}]}), encoding="utf-8")
+    (ref / "css" / "main.css").write_text(
+        "@media (max-width:768px){.child{padding-left:0}}", encoding="utf-8")
+    (impl / "package.json").write_text('{"name":"i","dependencies":{}}', encoding="utf-8")
+    proc = subprocess.run(["bash", str(SCRIPT), str(ref), str(impl)],
+                          capture_output=True, text=True, timeout=30)  # no forensic env
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert "paddingLeft" in _style_of(impl / "src", "child"), (
+        "flag off must leave inline box-model untouched"
+    )
