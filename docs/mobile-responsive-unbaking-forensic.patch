@@ -746,6 +752,264 @@ def _forensic_strip_boxmodel(styles):
     return {k: v for k, v in styles.items() if k not in _FORENSIC_BOXMODEL_PROPS}
 
 
+# ── @media-aware refinement ────────────────────────────────────────────────
+# The naive strip above is @media-agnostic: it drops an inline box-model prop
+# whenever the class appears anywhere in the ref CSS — including classes whose
+# only coverage is a DESKTOP base rule. That regresses desktop (the inline value
+# was the desktop truth; the base rule may differ or be absent). Media-aware
+# mode only strips a prop when some @media block actually overrides it for one
+# of the node's classes, so the desktop base value stays inline and only the
+# mobile-overridden props yield to ref CSS. Gated by UI_CLONE_FORENSIC_MEDIA_AWARE=1.
+_MEDIA_RULE_PROPS = {}  # frozenset(subject compound classes) -> tracked box-model props set under @media
+_BASE_RULE_PROPS = {}   # frozenset(subject compound classes) -> tracked box-model props set by NON-@media (desktop) rules
+# Per-token buckets for O(node-classes) lookup instead of O(all-rules) per node
+# (a full-index subset scan per DOM node is O(nodes × rules) and pushed navercorp's
+# 2.6MB-CSS transpile past 10min). Each requirement is anchored under one class
+# token; a node satisfying it necessarily carries that token, so scanning only the
+# node's own class buckets finds every applicable rule.
+_MEDIA_BUCKETS = {}     # class token -> list[(req_frozenset, props_set)]
+_BASE_BUCKETS = {}      # class token -> list[(req_frozenset, props_set)]
+
+
+def _forensic_media_aware():
+    return (
+        _forensic_classname_only()
+        and os.environ.get("UI_CLONE_FORENSIC_MEDIA_AWARE") == "1"
+    )
+
+
+def _expand_boxmodel_prop(name):
+    name = name.strip().lower()
+    if name in _FORENSIC_BOXMODEL_PROPS:
+        return {name}
+    if name in ("width", "height"):
+        return {name}
+    if name == "padding":
+        return {"padding-left", "padding-right", "padding-top", "padding-bottom"}
+    if name == "padding-inline":
+        return {"padding-left", "padding-right"}
+    if name == "padding-block":
+        return {"padding-top", "padding-bottom"}
+    if name in ("margin", "margin-inline"):
+        return {"margin-left", "margin-right"}
+    # codex P2 — a side-specific LOGICAL prop maps to ONE physical side, not both;
+    # expanding `padding-inline-start` to left+right would strip the opposite
+    # side's desktop value that the rule never touches. Assume LTR (physical-left
+    # = inline-start), which holds for the sites this pipeline targets; flag-gated.
+    if name == "padding-inline-start":
+        return {"padding-left"}
+    if name == "padding-inline-end":
+        return {"padding-right"}
+    if name == "margin-inline-start":
+        return {"margin-left"}
+    if name == "margin-inline-end":
+        return {"margin-right"}
+    return set()
+
+
+def _subject_compounds(sel, cls_re):
+    """Class-requirement sets of a selector's SUBJECT (rightmost compound) — one
+    frozenset per comma selector. Splits the comma list, then for each takes the
+    segment after the last combinator (space/>/+/~) and returns ALL its class
+    tokens as one requirement: `.page .card` → [{card}]; `.a, .b>.c` → [{a},{c}];
+    a COMPOUND `.card.featured` → [{card, featured}] (a node must carry EVERY
+    class to match — keying tokens independently would strip a node that has only
+    `card`). Descendant/ancestor scope classes are excluded (codex P2).
+
+    Pseudo-classes/elements and attribute selectors are stripped from the subject
+    before class extraction: `.card:not(.featured)` → {card} (the `.featured` in
+    `:not()` is a NEGATIVE condition, not a required class — treating it as
+    required would wrongly keep a plain `.card`'s inline and never let the mobile
+    rule override it); `.card:hover`, `.card::before`, `.card[data-x]` → {card}."""
+    out = []
+    for one in sel.split(","):
+        one = one.strip()
+        if not one:
+            continue
+        subject = re.split(r"[\s>+~]+", one)[-1]
+        # drop attribute selectors and pseudo-class/element parts (incl. their
+        # parenthesised args like :not(.x)/:is(.a,.b)) so only real compound
+        # classes remain as requirements.
+        subject = re.sub(r"\[[^\]]*\]", "", subject)
+        subject = re.sub(r"::?[A-Za-z-]+(?:\([^)]*\))?", "", subject)
+        classes = frozenset(cls_re.findall(subject))
+        if classes:
+            out.append(classes)
+    return out
+
+
+_NONSCREEN_MEDIA_TYPES = frozenset({
+    "print", "speech", "tty", "tv", "projection", "handheld", "braille",
+    "embossed", "aural",
+})
+
+
+def _media_prelude_targets_screen(prelude):
+    """True if a `@media` prelude can apply on screen. Keep the block if ANY comma
+    query is screen-applicable. Handles the `only`/`not` modifiers: `not print`
+    applies to screen but `not screen`/`not all` do not; `only print` is
+    print-only. So `print`/`only print`/`not screen` → skip; `not print`,
+    `screen and ...`, `all`, bare feature `(max-width:600px)`, and
+    `print, (max-width:600px)` → keep (codex P2)."""
+    for q in prelude.split(","):
+        q = q.strip()
+        if not q:
+            continue
+        negated = q.startswith("not ")
+        if negated:
+            q = q[4:].strip()
+        elif q.startswith("only "):
+            q = q[5:].strip()
+        head = re.split(r"[\s(]", q, 1)[0]
+        is_nonscreen = head in _NONSCREEN_MEDIA_TYPES
+        if negated:
+            # `not <nonscreen>` (e.g. not print) DOES apply on screen; `not screen`
+            # / `not all` exclude screen — keep scanning the other queries.
+            if is_nonscreen:
+                return True
+            continue
+        if is_nonscreen:
+            continue  # a bare non-screen media type — not screen-applicable
+        return True  # screen / all / bare feature query → applies to screen
+    return False
+
+
+def _build_media_index():
+    """Map each class token to the tracked box-model props some @media rule sets
+    for it. Coarse CSS parse: locate @media block bodies (brace-balanced), then
+    the selector { decls } rules inside, collecting .class tokens x declared props."""
+    global _MEDIA_RULE_PROPS, _BASE_RULE_PROPS
+    _MEDIA_RULE_PROPS = {}
+    _BASE_RULE_PROPS = {}
+    css = _REF_CSS_TEXT
+    if not css:
+        return
+    n = len(css)
+    i = 0
+    rule_re = re.compile(r"([^{}]+)\{([^{}]*)\}")
+    cls_re = re.compile(r"\.([A-Za-z0-9_-]+)")
+    prop_re = re.compile(r"(^|;)\s*([A-Za-z-]+)\s*:")
+
+    def _index_rules(text, target):
+        for rm in rule_re.finditer(text):
+            sel, decls = rm.group(1), rm.group(2)
+            props = set()
+            for pm in prop_re.finditer(decls):
+                props |= _expand_boxmodel_prop(pm.group(2))
+            if not props:
+                continue
+            # codex P2 — key by the rule's SUBJECT compound (rightmost). A
+            # descendant selector `.page .card{padding-left:0}` targets `.card`,
+            # not `.page` (marking `.page` would strip a wrapper the rule never
+            # matches); a compound `.card.featured` requires BOTH classes, so a
+            # node with only `card` must not be stripped.
+            for req in _subject_compounds(sel, cls_re):
+                cur = target.get(req)
+                if cur is None:
+                    target[req] = set(props)
+                else:
+                    cur.update(props)
+
+    media_spans = []
+    while True:
+        m = css.find("@media", i)
+        if m < 0:
+            break
+        # find the opening brace of the @media block
+        brace = css.find("{", m)
+        if brace < 0:
+            break
+        # brace-balanced block end (record the span for base-index exclusion
+        # regardless of screen filtering, so an @media rule is never also counted
+        # as a base/desktop rule).
+        depth = 1
+        j = brace + 1
+        while j < n and depth > 0:
+            c = css[j]
+            if c == "{":
+                depth += 1
+            elif c == "}":
+                depth -= 1
+            j += 1
+        media_spans.append((m, j))
+        i = j
+        # codex P2 — only index SCREEN-applicable media queries. A print/speech-
+        # only block (`@media print{...}`) never applies during visual
+        # verification, so stripping the inline layout it overrides would corrupt
+        # the screen clone. `not print`, `print, (max-width)`, and bare feature
+        # queries stay (they can apply on screen).
+        prelude = css[m + 6:brace].lower()
+        if not _media_prelude_targets_screen(prelude):
+            continue
+        _index_rules(css[brace + 1:j - 1], _MEDIA_RULE_PROPS)
+
+    # loop-nv-1 remeasure fix — base (non-@media) rules provide the DESKTOP value.
+    # A prop is only safe to strip when the ref CSS carries BOTH a @media override
+    # AND a desktop base value; if the desktop value exists only in the inline
+    # capture (no base rule — e.g. navercorp news-masonry/tech-grid width),
+    # stripping regresses desktop. Build the base index from the CSS with every
+    # @media block blanked out.
+    if media_spans:
+        parts, prev = [], 0
+        for s, e in media_spans:
+            parts.append(css[prev:s])
+            prev = e
+        parts.append(css[prev:])
+        base_css = "".join(parts)
+    else:
+        base_css = css
+    _index_rules(base_css, _BASE_RULE_PROPS)
+
+    # Bucket each requirement under ONE anchor class token for fast per-node
+    # lookup (see _MEDIA_BUCKETS comment). A node satisfying `req` carries every
+    # class in req, including its anchor, so scanning only the node's own class
+    # buckets is complete.
+    global _MEDIA_BUCKETS, _BASE_BUCKETS
+    _MEDIA_BUCKETS = _build_token_buckets(_MEDIA_RULE_PROPS)
+    _BASE_BUCKETS = _build_token_buckets(_BASE_RULE_PROPS)
+
+
+def _build_token_buckets(rule_props):
+    buckets = {}
+    for req, props in rule_props.items():
+        if not req:
+            continue
+        anchor = min(req)  # any single deterministic token in the requirement
+        buckets.setdefault(anchor, []).append((req, props))
+    return buckets
+
+
+def _forensic_props_for_node(node, buckets):
+    node_cls = set(str(node.get("class") or "").split())
+    if not node_cls:
+        return set()
+    out = set()
+    # a prop applies only if the node satisfies the FULL subject compound of some
+    # rule (every class present). Each req is bucketed under one of its tokens, so
+    # scanning the node's own class buckets covers every rule it can satisfy.
+    for t in node_cls:
+        for req, props in buckets.get(t, ()):
+            if req <= node_cls:
+                out |= props
+    return out
+
+
+def _forensic_strip_boxmodel_media_aware(styles, node):
+    media = _forensic_props_for_node(node, _MEDIA_BUCKETS)
+    if not media:
+        return styles
+    base = _forensic_props_for_node(node, _BASE_BUCKETS)
+    # Strip a prop only when BOTH a @media rule overrides it AND a non-@media base
+    # rule provides its desktop value. If the desktop value exists only in the
+    # inline capture (no base rule), stripping it removes the desktop truth and
+    # reflows the element — loop-nv-1 remeasure proved this (news-masonry /
+    # tech-grid width was inline-only → desktop +0.08 dSSIM). Keep those inline.
+    drop = media & base & set(_FORENSIC_BOXMODEL_PROPS)
+    if not drop:
+        return styles
+    return {k: v for k, v in styles.items() if k not in drop}
+
