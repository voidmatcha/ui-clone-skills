# benchmark trend + work artifacts are local-only (maintainer-only, per design).
benchmark/history/
benchmark/history.csv
benchmark/work/

# benchmark loop-iteration screenshots saved to repo root during sessions
loop*.png

# Validation loop workspaces — local clone targets, downloaded assets,
# per-loop ref dirs. Never committed to public repo (commercial-asset risk).
scratch/

# test-parity drift backups — auto-created during CI drift smoke tests
*.parity-backup

# Internal scratch dir for maintainer-only experiments
internal/

# Private maintainer growth/marketing research notes — never committed to public repo
research/

# Driver-session bypass marker — local-only maintainer state. Stop hook
# releases when this file's content matches the current
# CLAUDE_CODE_SESSION_ID env. See section_gate._is_driver_session.
.driver-session.id

# Vite local dependency cache — written by the dev server in any working dir
.vite/

# Outbox / handoff drops — per-session outbound artifacts
outbox/
.codex/artifacts/

# Local docs review artifacts — keep curated docs trackable while hiding
# per-run clone reviews and single-site E1 audit drops.
docs/clone-reviews/
docs/*-E1.md

# Convenience symlinks to scratch impl roots — created so pipeline.verify
# (which expects <repo>/impl) can locate a non-canonical impl path.
/impl

# Isolated implementation worktrees created by agent workflows
.worktrees/
.ui-re-continuation/
