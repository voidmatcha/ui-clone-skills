{
  "manifest_version": 3,
  "name": "ui-clone-skills — motion forensics",
  "version": "0.0.1",
  "description": "Run motion forensics on the current page. Decode / clone / verify / extract jobs via a local MCP server.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Motion forensics"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
