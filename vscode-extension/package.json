{
  "name": "ui-clone-skills",
  "displayName": "Motion forensics",
  "description": "Decode / clone / verify / extract any live URL with ui-clone-skills.",
  "version": "0.0.1",
  "publisher": "voidmatcha",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidmatcha/ui-clone-skills"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:ui-clone-skills.decode",
    "onCommand:ui-clone-skills.clone",
    "onCommand:ui-clone-skills.verify",
    "onCommand:ui-clone-skills.extract"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ui-clone-skills.decode",
        "title": "Motion forensics: Decode URL",
        "category": "Motion forensics"
      },
      {
        "command": "ui-clone-skills.clone",
        "title": "Motion forensics: Clone URL to React + Tailwind",
        "category": "Motion forensics"
      },
      {
        "command": "ui-clone-skills.verify",
        "title": "Motion forensics: Verify impl against URL",
        "category": "Motion forensics"
      },
      {
        "command": "ui-clone-skills.extract",
        "title": "Motion forensics: Extract raw JSON",
        "category": "Motion forensics"
      }
    ],
    "configuration": {
      "title": "Motion forensics",
      "properties": {
        "ui-clone-skills.enginePath": {
          "type": "string",
          "default": "~/dev/ui-clone-skills",
          "description": "Local checkout of github.com/voidmatcha/ui-clone-skills."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
